# --- Required ---
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/niramaya?schema=public"
# Generate with: pnpm dlx auth secret   (use a different value in production)
AUTH_SECRET="generate-with-pnpm-dlx-auth-secret"
NEXTAUTH_URL="http://localhost:3000"

# --- First administrator (used by `pnpm db:bootstrap`, which is safe on a live database) ---
# Password needs 10+ characters with letters and numbers. The account must change it at first sign-in.
ADMIN_EMAIL="you@example.org"
ADMIN_PASSWORD="choose-a-long-password-1"
ADMIN_NAME="Hospital Administrator"

# --- Optional ---
# Hospital time zone, used for "today", appointment hours and monthly reports (IANA name).
NEXT_PUBLIC_HOSPITAL_TIMEZONE="Asia/Kolkata"
# Public online booking is accepted only between these hours (hospital time).
BOOKING_OPEN_HOUR="8"
BOOKING_CLOSE_HOUR="20"
# How many reverse proxies sit in front of the app (Vercel/most hosts: 1). 0 = ignore X-Forwarded-For.
# Wrong values make rate limits per-proxy instead of per-visitor, or let visitors spoof their address.
TRUSTED_PROXY_HOPS="0"
# Shows the demo accounts on the login page. Leave unset/false in production.
NEXT_PUBLIC_SHOW_DEMO_ACCOUNTS="false"
# Only for `pnpm db:seed`: the seed wipes all data and refuses to run against a remote host or
# NODE_ENV=production unless this is "yes". Never set it on a real system.
# ALLOW_SEED_WIPE="yes"
